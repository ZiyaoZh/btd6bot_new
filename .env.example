# 指定机器人监听的群号
BOT_TARGET_GROUP_ID=123456
BOT_TARGET_GROUP_IDS=123456

# 机器人 QQ 号（可选，用于忽略自己发出的消息）
BOT_QQ=123456

# 机器人名称（用于管理员指令中的 @机器人名 校验）
BOT_NAME=小污猫

# 说明书文件路径（用于 manual_query 指令）
BOT_MANUAL_FILE=manuals/program_manual.md

# Agent Harness 最大工具执行批次
BOT_MAX_TOOL_ROUNDS=10

# Harness 运行限制
BOT_TOOL_TIMEOUT_SECONDS=180
BOT_MAX_TOOL_RESULT_CHARS=60000
BOT_RUN_TIMEOUT_SECONDS=660

# 是否开启主动接话（false 时仅响应 @机器人 的消息）
BOT_PROACTIVE_CHAT_ENABLED=false

# 活动数据后台刷新间隔（秒），机器人启动后会自动定时刷新
BOT_GAME_NEWS_REFRESH_INTERVAL_SECONDS=600

# 机器人轻量数据库文件路径
BOT_DB_FILE=data/bot_data.db

# Agent 产物统一目录、有效期与过期存档保留期（秒）
BOT_ARTIFACT_ROOT=data/artifacts
BOT_ARTIFACT_ACTIVITY_TTL_SECONDS=600
BOT_ARTIFACT_IMAGE_TTL_SECONDS=604800
BOT_ARTIFACT_DEFAULT_TTL_SECONDS=86400
BOT_ARTIFACT_ARCHIVE_RETENTION_SECONDS=604800

# 触发前缀（留空表示群内所有消息都走 LLM）
BOT_TRIGGER_PREFIX=

# 流水日志文件（记录完整数据传输流程）
BOT_FLOW_LOG_FILE=logs/network.log

# OpenAI 兼容接口配置
LLM_API_KEY=replace_me
LLM_API_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# AI 生图工具配置（仅服务端使用，不会暴露为 Agent 工具参数）
IMAGE_GEN_API_BASE_URL=https://api.openai.com/v1
IMAGE_GEN_API_KEY=replace_me
IMAGE_GEN_MODEL=gpt-image-1
IMAGE_GEN_REQUEST_TIMEOUT=180
IMAGE_GEN_MAX_RETRIES=2
IMAGE_GEN_RETRY_DELAY_SECONDS=2
# false 表示生图接口直连，不继承容器的 HTTP_PROXY/HTTPS_PROXY
IMAGE_GEN_USE_PROXY=false
IMAGE_GEN_MAX_BYTES=20971520

# 可选项
LLM_REQUEST_TIMEOUT=30
LLM_HISTORY_TURNS=6
LLM_MAX_REPLY_CHARS=1200
LLM_MAX_RETRIES=20

# 知识库 LLM 清洗配置（仅在手工/定时执行 --llm-clean 时使用，不复用上面的聊天 LLM 配置）
KB_LLM_API_KEY=replace_me
KB_LLM_API_BASE_URL=https://api.openai.com/v1
KB_LLM_MODEL=gpt-4o-mini
KB_LLM_MAX_CHUNK_CHARS=6000
KB_LLM_CHUNK_OVERLAP_CHARS=300
KB_LLM_REQUEST_TIMEOUT=60
KB_LLM_MAX_RETRIES=3
KB_LLM_RETRY_DELAY=0.8
KB_LLM_TEMPERATURE=0.0
# 留空表示不向接口传 max_tokens
KB_LLM_MAX_OUTPUT_TOKENS=

# Agent 工具选择提示词（Markdown）
LLM_ROUTER_TOOL_HINTS_FILE=prompts/router_tool_hints.md

# 系统提示词（推荐使用 Markdown 文件）
LLM_SYSTEM_PROMPT_FILE=prompts/system_prompt.md

# SSH proxy sidecar (Docker-host filesystem paths)
SSH_PROXY_KEY_PATH=/home/your-user/.ssh/id_ed25519
SSH_PROXY_KNOWN_HOSTS_PATH=/absolute/path/to/deploy/.private/ssh-proxy-known-hosts
SSH_PROXY_TARGET=your-user@proxy.example.com
